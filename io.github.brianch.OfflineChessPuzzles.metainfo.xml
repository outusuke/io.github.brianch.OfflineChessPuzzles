<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.brianch.OfflineChessPuzzles</id>
  <name>Offline Chess Puzzles</name>
  <summary>View and solve puzzles from the lichess puzzle database, offline</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.brianch">
    <name>brianch</name>
  </developer>

  <description>
    <p>
      Offline Chess Puzzles is a tool to browse and solve tactics puzzles
      from the lichess puzzle database without an internet connection. It
      supports filtering by rating, theme and opening, an analysis board
      with basic engine support, hints, favorites, and exporting puzzles
      to PDF or JPG.
    </p>
    <p>
      The puzzle database can be downloaded automatically on first run, or
      supplied manually if you're fully offline.
    </p>
  </description>

  <launchable type="desktop-id">io.github.brianch.OfflineChessPuzzles.desktop</launchable>

